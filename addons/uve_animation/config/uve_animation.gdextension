[configuration]
entry_symbol = "uve_animation_library_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.x86_64 = "res://addons/uve_animation/bin/libuve_animation.linux.x86_64.so"
windows.x86_64 = "res://addons/uve_animation/bin/uve_animation.windows.x86_64.dll"
macos.arm64 = "res://addons/uve_animation/bin/libuve_animation.macos.arm64.dylib"
android.arm64 = "res://addons/uve_animation/bin/libuve_animation.android.arm64.so"
android.armeabi-v7a = "res://addons/uve_animation/bin/libuve_animation.android.armeabi-v7a.so"
web.wasm32 = "res://addons/uve_animation/bin/libuve_animation.web.wasm32.wasm"
